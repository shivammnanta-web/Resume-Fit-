# ==============================================================================
# ResumeFit Environment Configuration
# Copy this file to .env and adjust variables as needed.
# All variables can override default.yaml via prefix RESUMEFIT__<SECTION>__<KEY>
# ==============================================================================

# Application Settings
RESUMEFIT__APP__ENVIRONMENT=development
RESUMEFIT__APP__DEBUG=false
RESUMEFIT__APP__LOG_LEVEL=INFO
RESUMEFIT__APP__LOG_FORMAT=text  # Use "json" for production logging
RESUMEFIT__APP__SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Matching Weights & Thresholds
RESUMEFIT__MATCHING__ALPHA=0.4
RESUMEFIT__MATCHING__BETA=0.6
RESUMEFIT__MATCHING__FUSION_METHOD=weighted  # "weighted" or "rrf"
RESUMEFIT__MATCHING__NORMALIZER=percentile   # "percentile" or "minmax"
RESUMEFIT__MATCHING__CROSS_ENCODER_ENABLED=false

# Database & Vector Store (PostgreSQL 15 + pgvector)
RESUMEFIT__DATABASE__URL=postgresql://resumefit:resumefit@localhost:5432/resumefit
RESUMEFIT__DATABASE__HNSW_EF_SEARCH=40

# Rate Limiting
RESUMEFIT__APP__RATE_LIMIT_ANALYZE="10 per minute"
RESUMEFIT__APP__RATE_LIMIT_DEFAULT="30 per minute"
